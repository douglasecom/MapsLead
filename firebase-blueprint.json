{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing roles, credits, team association, and subscriptions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["Administrador", "Gestor", "SDR", "Closer", "Operador"] },
        "avatarUrl": { "type": "string" },
        "plan": { "type": "string" },
        "credits": { "type": "number" },
        "remainingCredits": { "type": "number" },
        "bonusCredits": { "type": "number" },
        "planCredits": { "type": "number" },
        "purchasedCredits": { "type": "number" },
        "accountStatus": { "type": "string", "enum": ["ACTIVE", "LIMITED"] },
        "teamId": { "type": "string" },
        "subscriptionStatus": { "type": "string", "enum": ["ACTIVE", "PENDING", "OVERDUE", "CANCELED"] },
        "asaasCustomerId": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "plan", "credits"]
    },
    "Lead": {
      "title": "Lead",
      "description": "B2B sales lead captured or generated from Google Maps.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "niche": { "type": "string" },
        "location": { "type": "string" },
        "rating": { "type": "number" },
        "reviews": { "type": "number" },
        "hasWebsite": { "type": "boolean" },
        "hasGmbActive": { "type": "boolean" },
        "hasPhone": { "type": "boolean" },
        "phone": { "type": "string" },
        "leadScore": { "type": "number" },
        "status": { "type": "string" },
        "captured": { "type": "boolean" },
        "capturedAt": { "type": "string" },
        "gmbAnalysis": { "type": "string" }
      },
      "required": ["id", "name", "niche", "location", "rating", "reviews", "hasWebsite", "hasGmbActive", "hasPhone", "phone", "leadScore", "status", "captured", "gmbAnalysis"]
    },
    "SaaSPlan": {
      "title": "SaaSPlan",
      "description": "Applet commercial plan quotas and parameters.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "credits": { "type": "number" },
        "maxUsers": { "type": "number" },
        "maxReports": { "type": "number" },
        "maxLeads": { "type": "number" },
        "features": { "type": "array" }
      },
      "required": ["id", "name", "price", "credits", "maxUsers", "maxReports", "maxLeads", "features"]
    },
    "SaaSSubscription": {
      "title": "SaaSSubscription",
      "description": "The current state of organization subscriptions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "teamId": { "type": "string" },
        "status": { "type": "string" },
        "planId": { "type": "string" },
        "price": { "type": "number" },
        "nextBillingDate": { "type": "string" },
        "asaasSubscriptionId": { "type": "string" }
      },
      "required": ["id", "userId", "status", "planId", "price", "nextBillingDate"]
    },
    "SaaSPayment": {
      "title": "SaaSPayment",
      "description": "Log of monthly fees processed on the subscription gateway.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "teamId": { "type": "string" },
        "date": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "status": { "type": "string" },
        "link": { "type": "string" }
      },
      "required": ["id", "userId", "date", "amount", "method", "status"]
    },
    "SaaSTeam": {
      "title": "SaaSTeam",
      "description": "Team groups to enforce seat controls matching subscriptions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "members": { "type": "array" },
        "maxMembers": { "type": "number" }
      },
      "required": ["id", "ownerId", "members", "maxMembers"]
    },
    "SaaSActivityLog": {
      "title": "SaaSActivityLog",
      "description": "System usage audit trails.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "action", "details", "createdAt"]
    },
    "AiUsage": {
      "title": "AiUsage",
      "description": "AI consumption logs to track user's message tier limits.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "plan": { "type": "string" },
        "messagesUsed": { "type": "number" },
        "messagesLimit": { "type": "number" },
        "lastResetDate": { "type": "string" }
      },
      "required": ["userId", "plan", "messagesUsed", "messagesLimit", "lastResetDate"]
    },
    "AiLog": {
      "title": "AiLog",
      "description": "Log of user prompts and AI-generated outputs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "empresa": { "type": "string" },
        "pergunta": { "type": "string" },
        "resposta": { "type": "string" },
        "timestamp": { "type": "string" },
        "modelo": { "type": "string" }
      },
      "required": ["id", "userId", "empresa", "pergunta", "resposta", "timestamp", "modelo"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Global and system-wide setting parameters.",
      "type": "object",
      "properties": {
        "internalEmails": { "type": "array" }
      },
      "required": []
    },
    "CreditConfig": {
      "title": "CreditConfig",
      "description": "Utility parameters and consumption multipliers for the credit system.",
      "type": "object",
      "properties": {
        "ai_search_factor": { "type": "number" },
        "lead_capture_factor": { "type": "number" },
        "lead_delete_factor": { "type": "number" }
      },
      "required": []
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Agenda meetings associated with B2B leads.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "responsible": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "type": { "type": "string" },
        "observations": { "type": "string" },
        "status": { "type": "string" },
        "leadId": { "type": "string" },
        "meetLink": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "whatsapp": { "type": "string" },
        "city": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "company", "responsible", "date", "time", "type", "status"]
    },
    "LeadSearchCache": {
      "title": "LeadSearchCache",
      "description": "Cache collection for high-efficiency Maps and database searching.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "searchKey": { "type": "string" },
        "niche": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "totalResults": { "type": "number" },
        "lastUpdated": { "type": "string" },
        "source": { "type": "string" },
        "leads": { "type": "array" }
      },
      "required": ["id", "searchKey", "niche", "city", "state", "totalResults", "lastUpdated", "source", "leads"]
    },
    "Company": {
      "title": "Company",
      "description": "Unique corporate entity stored to avoid duplicate records.",
      "type": "object",
      "properties": {
        "placeId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "website": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "category": { "type": "string" },
        "source": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["placeId", "name", "address", "city", "state", "updatedAt"]
    },
    "LeadSearchStats": {
      "title": "LeadSearchStats",
      "description": "Performance counters and analytics tracking API savings & caching health.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companiesStoredCount": { "type": "number" },
        "cacheHits": { "type": "number" },
        "mapsCalls": { "type": "number" },
        "estimatedApiSavings": { "type": "number" },
        "estimatedMonthlySavings": { "type": "number" },
        "topCities": { "type": "array" },
        "topNiches": { "type": "array" },
        "lastCacheUpdate": { "type": "string" }
      },
      "required": ["id", "companiesStoredCount", "cacheHits", "mapsCalls", "estimatedApiSavings", "estimatedMonthlySavings"]
    }
  },
  "firestore": {
    "/meetings/{meetingId}": {
      "schema": "Meeting",
      "description": "Meetings and appointments scheduled inside AdsHive CRM."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with tenancy details."
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Leads acquired by active organizations."
    },
    "/plans/{planId}": {
      "schema": "SaaSPlan",
      "description": "SaaS pricing plans of the application."
    },
    "/subscriptions/{subId}": {
      "schema": "SaaSSubscription",
      "description": "Asaas integrated recurring subscriptions."
    },
    "/payments/{payId}": {
      "schema": "SaaSPayment",
      "description": "Log of monthly fees processed on the subscription gateway."
    },
    "/teams/{teamId}": {
      "schema": "SaaSTeam",
      "description": "Multi-user team associations to control team seats limit."
    },
    "/activityLogs/{logId}": {
      "schema": "SaaSActivityLog",
      "description": "Audit trails logged for CRM and operations."
    },
    "/aiUsage/{userId}": {
      "schema": "AiUsage",
      "description": "AI quotas tracks organizational consumption dynamically."
    },
    "/aiLogs/{logId}": {
      "schema": "AiLog",
      "description": "Prompt execution histories of Gemini query parameters."
    },
    "/settings/{settingId}": {
      "schema": "SystemSetting",
      "description": "White label configurations and access email list filters."
    },
    "/creditConfigs/{configId}": {
      "schema": "CreditConfig",
      "description": "Admin configurable parameters adjusting operational costs on credits."
    },
    "/leadSearchCache/{cacheId}": {
      "schema": "LeadSearchCache",
      "description": "Regional query caches to minimize Google Maps API consumption."
    },
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Global normalized list of unique real verified companies."
    },
    "/leadSearchStats/{statId}": {
      "schema": "LeadSearchStats",
      "description": "High level system-wide statistics for the owner dashboard."
    }
  }
}
